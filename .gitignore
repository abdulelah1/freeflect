# Dependencies
node_modules/
.pnpm-store/

# Build output
target/
dist/
out/
release/
coverage/
*.tsbuildinfo

# Native addon (napi-rs builds and generates these)
*.node
crates/node-bindings/index.js
crates/node-bindings/index.d.ts
crates/node-bindings/.*.tmp
crates/node-bindings/.napi-rs-filesystem-transaction.swp/

# Android phone server
android-server/build/

# macOS and iPhone builds (the Xcode project is generated by XcodeGen)
native/macos/build/
native/ios/build/
native/ios/MirrorCompanion/MirrorCompanion.xcodeproj/
xcuserdata/
*.xcuserstate
DerivedData/

# Test media (generated by pnpm spike:fixture) and logs
fixtures/*.h264
*.log

# Signing material and secrets: never commit these
.env
.env.*
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain-db

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

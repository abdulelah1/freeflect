{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "The clipboard has no text to send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحافظة لا تحتوي على نص لإرساله."
          }
        }
      }
    },
    "Clipboard sent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت الحافظة"
          }
        }
      }
    },
    "Sent %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل %@"
          }
        }
      }
    },
    "Received %@. Find it in the Files app, On My iPhone, FreeFlect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل %@. تجده في تطبيق الملفات، ضمن على الآيفون، فريفلكت."
          }
        }
      }
    },
    "Copied from your computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نُسخ من الكمبيوتر"
          }
        }
      }
    },
    "Screen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشاشة"
          }
        }
      }
    },
    "Share screen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاركة الشاشة"
          }
        }
      }
    },
    "Tap the button, choose FreeFlect, then Start Broadcast.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط الزر، واختر فريفلكت، ثم بدء البث."
          }
        }
      }
    },
    "Send to computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال إلى الكمبيوتر"
          }
        }
      }
    },
    "Send clipboard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الحافظة"
          }
        }
      }
    },
    "Send photos or videos": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال صور أو فيديوهات"
          }
        }
      }
    },
    "Send files": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال ملفات"
          }
        }
      }
    },
    "FreeFlect": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فريفلكت"
          }
        }
      }
    },
    "Looking for your computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ البحث عن الكمبيوتر"
          }
        }
      }
    },
    "Open FreeFlect on your computer and keep both on the same Wi-Fi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح فريفلكت على الكمبيوتر وأبقِ الجهازين على نفس شبكة الواي فاي."
          }
        }
      }
    },
    "Connected to %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل بـ %@"
          }
        }
      }
    },
    "Sending to %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الإرسال إلى %@"
          }
        }
      }
    },
    "Sent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإرسال"
          }
        }
      }
    },
    "Turn on Local Network for FreeFlect in Settings, Privacy & Security, Local Network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الشبكة المحلية لتطبيق فريفلكت من الإعدادات، الخصوصية والأمن، الشبكة المحلية."
          }
        }
      }
    },
    "Can't search this network: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر البحث في هذه الشبكة: %@"
          }
        }
      }
    },
    "Couldn't reach %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى %@."
          }
        }
      }
    },
    "The computer refused the connection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الكمبيوتر الاتصال."
          }
        }
      }
    },
    "Disconnected from %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بـ %@."
          }
        }
      }
    },
    "your computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكمبيوتر"
          }
        }
      }
    },
    "No computer answered. Check that both are on the same Wi-Fi and that Pair iPhone is open on the computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرد أي كمبيوتر. تأكد من أن الجهازين على شبكة الواي فاي نفسها وأن نافذة إقران آيفون مفتوحة على الكمبيوتر."
          }
        }
      }
    },
    "Couldn't reach the computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الكمبيوتر."
          }
        }
      }
    },
    "That code doesn't match. Check the code on the computer and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز غير مطابق. تحقق من الرمز على الكمبيوتر وحاول مجددًا."
          }
        }
      }
    },
    "This isn't the computer this iPhone is paired with. If you reinstalled FreeFlect there, pair again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس الكمبيوتر المقترن بهذا الآيفون. إذا أعدت تثبيت فريفلكت عليه، فأقرنه من جديد."
          }
        }
      }
    },
    "Open the FreeFlect app and pair this iPhone with your computer first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق فريفلكت وأقرن هذا الآيفون بالكمبيوتر أولًا."
          }
        }
      }
    },
    "That isn't a FreeFlect pairing code. On the computer, open Settings and choose Pair iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس رمز إقران فريفلكت. على الكمبيوتر، افتح الإعدادات واختر إقران آيفون."
          }
        }
      }
    },
    "On your computer, open FreeFlect, then Settings, and choose Pair iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الكمبيوتر، افتح فريفلكت ثم الإعدادات، واختر إقران آيفون."
          }
        }
      }
    },
    "Scan the QR code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR"
          }
        }
      }
    },
    "Type a code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتابة رمز"
          }
        }
      }
    },
    "Pairing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الإقران"
          }
        }
      }
    },
    "Pair with a computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإقران مع كمبيوتر"
          }
        }
      }
    },
    "Computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكمبيوتر"
          }
        }
      }
    },
    "Paired with %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقترن بـ %@"
          }
        }
      }
    },
    "Forget this computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسيان هذا الكمبيوتر"
          }
        }
      }
    },
    "Not paired with a computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مقترن بكمبيوتر"
          }
        }
      }
    },
    "Enter the code shown under the QR code on your computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز الظاهر أسفل رمز QR على الكمبيوتر."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إقران"
          }
        }
      }
    },
    "Allow FreeFlect to use the camera in Settings, or type the code instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لفريفلكت باستخدام الكاميرا من الإعدادات، أو اكتب الرمز بدلًا من ذلك."
          }
        }
      }
    },
    "XXXX-XXXX": {
      "shouldTranslate": false
    },
    "FreeFlect finds your computer on your Wi-Fi to send it your screen, clipboard and files. It only talks to the computer you pair with, over an encrypted connection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر فريفلكت على الكمبيوتر في شبكة الواي فاي لإرسال شاشتك وحافظتك وملفاتك إليه. لا يتواصل إلا مع الكمبيوتر الذي تقرنه به، عبر اتصال مشفّر."
          }
        }
      }
    },
    "iOS asks whether FreeFlect may find devices on your local network. Tap Allow. Without it, FreeFlect can't reach your computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل iOS هل يُسمح لفريفلكت بالعثور على الأجهزة في شبكتك المحلية. اضغط على سماح. بدون ذلك لا يستطيع فريفلكت الوصول إلى الكمبيوتر."
          }
        }
      }
    },
    "Local network": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة المحلية"
          }
        }
      }
    },
    "FreeFlect needs the camera only to read the pairing code on your computer's screen. It's on only while you scan, and nothing is recorded or saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج فريفلكت إلى الكاميرا فقط لقراءة رمز الإقران على شاشة الكمبيوتر. تعمل فقط أثناء المسح، ولا يُسجَّل أو يُحفظ أي شيء."
          }
        }
      }
    },
    "iOS asks whether FreeFlect may use the camera. Tap Allow. Or choose Type a code instead, which needs no camera.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل iOS هل يُسمح لفريفلكت باستخدام الكاميرا. اضغط على سماح. أو اختر كتابة رمز بدلًا من ذلك، فهو لا يحتاج إلى كاميرا."
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا"
          }
        }
      }
    },
    "Before you pair": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل الإقران"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الآن"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        }
      }
    }
  }
}